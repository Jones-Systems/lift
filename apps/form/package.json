{
  "name": "form-private",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-token-styles.cjs",
    "test:api": "node scripts/run-api-tests.cjs",
    "test:integration": "node --test --test-concurrency=1 src/integration/tests/*.test.cjs",
    "test:renderer": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "expo": "57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-secure-store": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.10.1",
    "expo-build-properties": "~57.0.22"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.1.0",
    "test-renderer": "1.2.0",
    "@types/jest": "29.5.14"
  }
}
